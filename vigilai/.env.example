# ── IA (obligatorio para la detección) ─────────────────────────────
# Clave de la API de Claude. Sin ella, el monitor captura frames pero el
# análisis devuelve error.
ANTHROPIC_API_KEY=

# ── Persistencia ───────────────────────────────────────────────────
# Si defines DATABASE_URL se usa Postgres; si no, un almacén JSON local.
# El esquema se crea automáticamente en el primer uso.
# DATABASE_URL=postgres://usuario:password@host:5432/vigilai
# Fuerza SSL con proveedores gestionados (o usa ?sslmode=require en la URL):
# PGSSL=true

# Modelo de visión a usar. Por defecto claude-opus-4-8.
# Alternativas para abaratar a gran escala: claude-sonnet-4-6, claude-haiku-4-5
# DETECTION_MODEL=claude-opus-4-8

# ── Email (Resend) — opcional ──────────────────────────────────────
# Sin esto, el email funciona en modo simulación (se imprime en consola).
RESEND_API_KEY=
EMAIL_FROM=VigilAI <alerts@tudominio.com>

# ── SMS (Twilio) — opcional ────────────────────────────────────────
# Sin esto, el SMS funciona en modo simulación.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Push (Web Push / VAPID) — opcional ─────────────────────────────
# Genera el par de claves con:  npx web-push generate-vapid-keys
# Sin esto, el push funciona en modo simulación.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@tudominio.com
